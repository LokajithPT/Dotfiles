-- ========================
-- DuoLevelling Complete System
-- ========================

local M = {}

-- Configuration
local config = {
    backend_url = "http://localhost:8080/api/v1",
    send_interval = 10000, -- 10 seconds
    keystroke_threshold = 100, -- Daily threshold
    data_file = vim.fn.expand("~/.duolevelling/data.json"),
    log_file = vim.fn.expand("~/.duolevelling/activity.log"),
}

-- State tracking
local keystroke_count = 0
local current_file_path = nil
local last_send_time = 0
local timer = nil
local stats_cache = {
    streak = 0,
    today_keystrokes = 0,
    total_keystrokes = 0,
    is_approved = false,
}

-- ========================
-- DATA MANAGEMENT
-- ========================

local function ensure_data_dir()
    local dir = vim.fn.fnamemodify(config.data_file, ":h")
    vim.fn.mkdir(dir, "p")
end

local function load_stats()
    ensure_data_dir()
    if vim.fn.filereadable(config.data_file) == 1 then
        local content = vim.fn.readfile(config.data_file)
        local ok, data = pcall(vim.json.decode, content)
        if ok then
            stats_cache = data
        end
    end
end

local function save_stats()
    ensure_data_dir()
    local content = vim.json.encode(stats_cache)
    vim.fn.writefile(config.data_file, content)
end

local function log_activity(message)
    ensure_data_dir()
    local timestamp = os.date("%Y-%m-%d %H:%M:%S")
    local log_entry = string.format("[%s] %s\n", timestamp, message)
    local log_file = io.open(config.log_file, "a")
    if log_file then
        log_file:write(log_entry)
        log_file:close()
    end
end

-- ========================
-- KEYSTROKE TRACKING
-- ========================

local function count_keystroke()
    if vim.fn.mode() == "i" then
        keystroke_count = keystroke_count + 1
        current_file_path = vim.api.nvim_buf_get_name(0)
        
        -- Update local stats
        stats_cache.today_keystrokes = stats_cache.today_keystrokes + 1
        stats_cache.total_keystrokes = stats_cache.total_keystrokes + 1
    end
end

local function send_to_backend()
    if keystroke_count == 0 then
        return
    end

    local data = {
        user_id = "coder1",
        activity_type = "keystroke",
        count = keystroke_count,
        file_path = current_file_path or "unknown",
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S")
    }

    local json_data = vim.json.encode(data)
    local cmd = string.format('curl -s -f -X POST -H "Content-Type: application/json" -d %q %s/activity >/dev/null 2>&1 && echo "SUCCESS" || echo "FAILED"', json_data, config.backend_url)
    
    vim.fn.jobstart(cmd, {
        detach = true,
        on_exit = function(_, exit_code)
            if exit_code == 0 then
                vim.notify("🔥 Sent " .. keystroke_count .. " keystrokes to backend", vim.log.levels.INFO)
                keystroke_count = 0
                last_send_time = os.time()
            else
                vim.notify("❌ Failed to send data", vim.log.levels.ERROR)
            end
        end
    })
end

-- ========================
-- FETCH STATS FROM BACKEND
-- ========================

local function fetch_stats()
    local cmd = string.format('curl -s "%s/stats?user_id=coder1" 2>/dev/null || echo "FAILED"', config.backend_url)
    
    vim.fn.jobstart(cmd, {
        detach = true,
        on_exit = function(_, exit_code, stdout)
            if exit_code == 0 and stdout and stdout ~= "" then
                local ok, data = pcall(vim.json.decode, stdout)
                if ok then
                    stats_cache.streak = data.streak or 0
                    stats_cache.today_keystrokes = data.today_keystrokes or 0
                    stats_cache.total_keystrokes = data.total_keystrokes or 0
                    stats_cache.is_approved = data.is_approved or false
                    
                    save_stats()
                    vim.notify("📊 Stats updated! Streak: " .. stats_cache.streak, vim.log.levels.INFO)
                end
            end
        end
    })
end

-- ========================
-- UI COMPONENTS
-- ========================

local function show_profile_dialog()
    local streak_emoji = stats_cache.streak > 0 and "🔥" or "💤"
    
    local content = {
        "┌─────────────────────────────┐",
        "│ 🔥 DUOLEVELLING PROFILE      │",
        "├─────────────────────────────┤",
        "│",
        "│ Streak: " .. streak_emoji .. " " .. stats_cache.streak .. " days",
        "│",
        "│ Today's Keystrokes: ⌨️ " .. stats_cache.today_keystrokes,
        "│",
        "│ Total Keystrokes: 📊 " .. stats_cache.total_keystrokes,
        "│",
        "│ Status: " .. (stats_cache.is_approved and "✅ Approved" or "⏳ Pending"),
        "│",
        "└─────────────────────────────┘"
    }
    
    vim.api.nvim_echo(table.concat(content, "\n"))
end

-- Commands
vim.api.nvim_create_user_command("DuoLevellingProfile", show_profile_dialog, {
    desc = "Show detailed coding profile and stats"
})

vim.api.nvim_create_user_command("DuoLevellingSync", function()
    send_to_backend()
    fetch_stats()
end, {
    desc = "Sync data with backend"
})

vim.api.nvim_create_user_command("DuoLevellingSend", send_to_backend, {
    desc = "Send current keystrokes to backend"
})

vim.api.nvim_create_user_command("DuoLevellingOn", setup_auto_send, {
    desc = "Enable keystroke tracking"
})

vim.api.nvim_create_user_command("DuoLevellingOff", function()
    if timer then
        vim.fn.timer_stop(timer)
        timer = nil
    end
    vim.notify("💤 DuoLevelling tracking disabled", vim.log.levels.WARN)
end, {
    desc = "Disable keystroke tracking"
})

-- ========================
-- SETUP
-- ========================

function M.setup(user_config)
    if user_config then
        for k, v in pairs(user_config) do
            config[k] = v
        end
    end
    
    -- Load existing stats
    load_stats()
    
    -- Track keystrokes
    vim.api.nvim_create_autocmd({ "TextChangedI", count_keystroke})
    
    -- Auto-send data
    setup_auto_send()
    
    -- Send on exit
    vim.api.nvim_create_autocmd("VimLeavePre", function()
        send_to_backend()
        save_stats()
    end)
    
    -- Try to sync with backend on startup
    local check_cmd = "curl -s http://localhost:8080/heartbeat >/dev/null 2>&1"
    local result = vim.fn.system(check_cmd)
    
    if result == "UP" then
        vim.defer_fn(function()
            fetch_stats()
        end, 100)
        log_activity("Server available - synced stats")
    else
        log_activity("Server unavailable - using offline mode")
    end
    
    vim.notify("🔥 DuoLevelling system activated!", vim.log.levels.INFO)
end

return M